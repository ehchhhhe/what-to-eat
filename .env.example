# ============================================================================
# 服务端变量：只在 Node / Serverless 环境读取，不会进入前端构建产物。
# 请不要给这些变量加 VITE_ 前缀 —— 带 VITE_ 的变量会被编译进浏览器代码。
# 本地开发：复制为 .env；线上：填到 Netlify / Vercel 的环境变量里。
# ============================================================================

# 菜谱生成模型配置（文本生成）
TEXT_GENERATION_BASE_URL=https://api.302ai.cn/v1/
TEXT_GENERATION_API_KEY=xxxxxxxxxxxx
TEXT_GENERATION_MODEL=doubao-1.5-pro-32k

# 图片生成模型配置
IMAGE_GENERATION_BASE_URL=https://open.bigmodel.cn/api/paas/v4/images/generations
IMAGE_GENERATION_API_KEY=xxxxxxxxxxxxx
IMAGE_GENERATION_MODEL=cogview-3-flash

# 图片食材识别（视觉模型），默认复用上面的图片服务密钥，可用 VISION_API_KEY 单独覆盖
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
VISION_MODEL=GLM-4.1V-Thinking-Flash
# VISION_API_KEY=

# ============================================================================
# 可公开的前端变量：会被编译进前端，只能放非敏感参数
# ============================================================================
VITE_AI_TEMPERATURE=0.7
VITE_AI_TIMEOUT=300000
